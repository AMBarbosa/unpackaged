randomPoints <- function(n = 10, dx = 2, dy = 3, ext = c(-180, 180, -60, 60), df = FALSE) {

  if (dx <= 0 || dy <= 0 || n <= 0) {
    stop("dx, dy, and n must be positive values.")
  }

  # compute random window extent:
  xmin <- runif(1, ext[1], ext[2] - dx)
  ymin <- runif(1, ext[3], ext[4] - dy)
  xmax <- xmin + dx
  ymax <- ymin + dy

  # generate random points within that extent:
  x_coords <- runif(n, xmin, xmax)
  y_coords <- runif(n, ymin, ymax)

  # generate output:
  if (df) return(data.frame(x_coords, y_coords))
  return(terra::vect(cbind(x_coords, y_coords), type = "points", 
        crs = "+proj=longlat +datum=WGS84"))
}
